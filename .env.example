# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://vmapp:vmapp@postgres:5432/vmapp

# --- RustFS (S3-compatible) ---
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET_PROJECTS=vm-projects
RUSTFS_WEBHOOK_SECRET=dev-webhook-secret

# Terraform / Ansible artifact prefixes inside the bucket
RUSTFS_PREFIX_TERRAFORM=projects/terraform/
RUSTFS_PREFIX_ANSIBLE=projects/ansible/

# --- Floci (AWS local emulator; user may refer to this as "floti") ---
AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Floci-az (Azure local emulator / "floti-az") ---
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_STORAGE_KEY=Eby8vdM02xNOcqFeOwGOwPvbfSddjrRz3pB8CNjzfRs9HnI7P5EssuT3gT62HM2xu0bkEW6RizvIZcz1j5l3uWq+5vbsPRS/z8A8FGhXd9bUpCc5b2n2/6f3D9u0PBgJGB3GP/1xPsdZ6v+j8Z8HtM6DqdoxcWGCeCd8BTuOKy/+Z4uuh4Olqp4vMQe5Xq7MGD1WVV7e3OQ0qkoBPWgMX6Dc8/L6yYWWEzsEvHqPFpxX6K9xpvidKSWkdJAZw5x0AA==
AZURE_BLOB_ENDPOINT=http://floci-az:4577/devstoreaccount1
AZURE_QUEUE_ENDPOINT=http://floci-az:4577/devstoreaccount1-queue
AZURE_TABLE_ENDPOINT=http://floci-az:4577/devstoreaccount1-table
AZURE_FUNCTIONS_ENDPOINT=http://floci-az:4577/devstoreaccount1-functions

# --- mock-pve-api (Proxmox VE API simulator) ---
PROXMOX_API_URL=https://mock-pve:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=secret
PROXMOX_API_TOKEN=root@pam!test=secret
PROXMOX_INSECURE=true
MOCK_PVE_VERSION=8.3

# --- vcsim (VMware vSphere API simulator) ---
VSPHERE_URL=https://vcsim:8989/sdk
VSPHERE_USER=user
VSPHERE_PASSWORD=pass
VSPHERE_INSECURE=true

# --- Worker / Pipeline ---
WORKER_POLL_INTERVAL_SEC=10
TERRAFORM_DIR=/workspace/infra/terraform
ANSIBLE_DIR=/workspace/infra/ansible
PIPELINE_WORK_DIR=/tmp/pipeline-runs
